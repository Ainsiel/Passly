{
  "realm": "passly",
  "displayName": "Passly",
  "enabled": true,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "USER",
        "description": "Usuario estándar de Passly"
      },
      {
        "name": "ADMIN",
        "description": "Administrador del catálogo de eventos"
      },
      {
        "name": "default-roles-passly",
        "description": "${role_default-roles}",
        "composite": true,
        "composites": {
          "realm": [
            "USER"
          ],
          "client": {
            "account": [
              "manage-account",
              "manage-account-links",
              "view-profile"
            ]
          }
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "passly-web",
      "name": "Passly Web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@passly.local",
      "emailVerified": true,
      "firstName": "Administrador",
      "lastName": "Passly",
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ADMIN",
        "USER"
      ]
    }
  ]
}
